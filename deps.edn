{:paths ["src" "server"]

 :deps {http-kit/http-kit         {:mvn/version "2.8.0"}
        metosin/reitit-ring       {:mvn/version "0.7.2"}
        org.clojure/clojure       {:mvn/version "1.12.1"}
        com.datomic/local         {:mvn/version "1.0.291"}
        com.cognitect/transit-clj {:mvn/version "1.1.357"}}

 :aliases {;; clojure -M:server
           :server {:main-opts ["-m" "reading.server"]}

           ;; clojure -M:test  (runs the .clj and .cljc tests in test/)
           :test {:extra-paths ["test"]
                  :extra-deps {datascript/datascript {:mvn/version "1.7.8"}
                               io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :main-opts ["-m" "cognitect.test-runner"]}}}
